    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AshfallSync.Core</AssemblyName>
    <RootNamespace>UmbraSync</RootNamespace>
    <NoWarn>$(NoWarn);NU1900;MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UmbraAPI\UmbraSyncAPI\UmbraSync.API.csproj" />
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

</Project>
